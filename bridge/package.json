{
  "name": "bridge",
  "version": "0.1.0",
  "private": true,
  "description": "WebSocket bridge: maps app users to per-user mineflayer sessions on a Minecraft Java server.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "minecraft-data": "^3.113.0",
    "minecraft-protocol": "^1.66.2",
    "mineflayer": "^4.37.1",
    "prismarine-auth": "^3.1.1",
    "prismarine-chat": "^1.10.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
