# Minecraft server the bridge will join on behalf of users
MC_HOST=play.example.com
MC_PORT=25565
MC_VERSION=1.21.11

# WebSocket port the bridge listens on (HTTP /health on same port)
WS_PORT=8080

# Required for any public bridge. If set, clients must connect with either:
# Authorization: Bearer this-value
# ws://host:8080?token=this-value
BRIDGE_TOKEN=change-this-long-random-token

# Where prismarine-auth caches per-user Microsoft/Minecraft tokens
# Use a persistent volume in production (e.g. Fly.io volume mounted at /data)
TOKENS_DIR=./tokens

# Optional: comma-separated origins allowed for the WS upgrade. Empty = allow all.
# ALLOWED_ORIGINS=https://proll.github.io

# Optional: max concurrent sessions
MAX_SESSIONS=20

# Optional: chat rate limit (messages per second per user)
CHAT_RATE_LIMIT=2
