{
  "expo": {
    "name": "루둘기 앱",
    "slug": "proll-mc-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.proll.mcmobile"
    },
    "android": {
      "package": "com.proll.mcmobile",
      "adaptiveIcon": {
        "backgroundColor": "#0d1117"
      }
    },
    "web": {
      "bundler": "metro",
      "display": "standalone",
      "themeColor": "#0d1117",
      "backgroundColor": "#0d1117"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
